<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, regardless of feeds configured on the machine (user-level NuGet.Config).
  With central package management, more than one source triggers NU1507, which this repo treats as an error.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
