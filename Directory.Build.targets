<Project>
  <!--
    Avalonia's build tasks send build telemetry (Avalonia.BuildServices) unless AVALONIA_TELEMETRY_OPTOUT is set. This
    empty target replaces theirs, so no build in this repository sends it whatever the environment. It is imported
    after the package targets, and the later definition of a target wins.
  -->
  <Target Name="AvaloniaStats" />

  <!--
    A project that lists RuntimeIdentifiers (Directory.Build.props) would download the runtime packs of all of them on
    every restore, about 300 MB, in case it is published later without restoring. deploy/publish-desktop.sh restores
    for the runtime it publishes, so a restore for no particular runtime (build, test) skips them.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
  </PropertyGroup>

  <!--
    Package validation: `dotnet pack` compares each library package with the last release on nuget.org and fails on
    a public API that was removed or changed (CP0002 and the other CP diagnostics), so a break is caught in the pull
    request that makes it. Here, not in Directory.Build.props, because IsPackable and PackAsTool are set in the project
    files, which come after it; the tool has no API to compare. The baseline is downloaded by restore. Bump it to each
    new release, together with VersionPrefix (docs/releases.md#after-a-release); a deliberate break is suppressed in the
    project's CompatibilitySuppressions.xml (CONTRIBUTING.md, Public API and package validation). A new package with
    no release yet sets DisablePackageBaselineValidation to true in its project file until its first release.
  -->
  <PropertyGroup Label="Package validation" Condition="'$(IsPackable)' == 'true' and '$(PackAsTool)' != 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- The last version on nuget.org. -->
    <PackageValidationBaselineVersion>0.6.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    The public API files: each library lists its public API in PublicAPI.Shipped.txt (as released) and
    PublicAPI.Unshipped.txt (changed since), and the analyzer fails the build on a public type or member that is not
    listed (RS0016) or a listed one that is gone (RS0017). So every change to the surface is a line in the diff of the
    pull request that makes it, additions included, which package validation does not see. The release moves
    Unshipped into Shipped (docs/releases.md#after-a-release). CONTRIBUTING.md, Public API and package validation.
    The package's own build targets add both files as AdditionalFiles; adding them here as well gives each project
    two copies, which the compiler tolerates but makes `dotnet format` skip the RS0016 code fix.
  -->
  <ItemGroup Label="Public API files" Condition="'$(IsPackable)' == 'true' and '$(PackAsTool)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    What nuget.org shows on each package's page: the README.md in its project folder (what the package is, how to
    install it, a snippet, links to the docs) and the app icon. Here, not in Directory.Build.props, for the same reason
    as package validation: IsPackable and PackAsTool are set in the project files. A packable project without a
    README.md fails the pack (NU5039).
  -->
  <PropertyGroup Label="Package page" Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Label="Package page" Condition="'$(IsPackable)' == 'true'">
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)src/SemanticRouter.Desktop/Assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Symbols: each library package gets a symbol package (.snupkg) beside it with its portable PDB, which carries the
    SourceLink map to this repository's sources at the commit. The release pushes both, so nuget.org's symbol server
    serves the PDB and a debugger can step into the libraries and show line numbers in stack traces. The tool package
    carries its PDBs inside, as dotnet tools do, so it needs none. deploy/package-contents-check.sh checks the result.
  -->
  <PropertyGroup Label="Symbols" Condition="'$(IsPackable)' == 'true' and '$(PackAsTool)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    The first-party packages are versioned together and depend on each other exactly (CONTRIBUTING.md, Package
    versions and dependencies): Storage.Sqlite, Embeddings.Onnx and Connectors.Copilot are compiled against one build
    of SemanticRouter.AspNetCore, internals included, and AspNetCore against one build of SemanticRouter.Core. By
    default a project reference becomes an open lower bound in the nuspec (version="0.6.0", meaning 0.6.0 or later), so
    NuGet would pair an old package with a newer sibling and the app would fail at run time with a
    MissingMethodException. As [0.6.0], a mismatch is reported at restore instead (NU1107, or NU1608 when the app
    references the newer sibling itself).
  -->
  <Target Name="UseExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferences Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferences)" />
    </ItemGroup>
  </Target>

  <!--
    Fails the pack when the generated nuspec gives a SemanticRouter.* dependency anything but an exact version, so the
    rule above cannot silently stop applying (a renamed SDK target, a PackageReference to a sibling, a nuspec file).
    The package written with that nuspec is deleted, so no such package is left to publish.
  -->
  <Target Name="CheckExactSemanticRouterDependencies" AfterTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true' and '$(PackAsTool)' != 'true'">
    <ItemGroup>
      <_GeneratedNuspec Include="@(NuGetPackOutput)" Condition="'%(Extension)' == '.nuspec'" />
      <_GeneratedPackage Include="@(NuGetPackOutput)" Condition="'%(Extension)' != '.nuspec'" />
    </ItemGroup>
    <XmlPeek XmlInputPath="%(_GeneratedNuspec.FullPath)"
             Query="//*[local-name()='dependency'][starts-with(@id, 'SemanticRouter.')][not(starts-with(@version, '[') and substring(@version, string-length(@version)) = ']' and not(contains(@version, ',')))]/@id"
             Condition="'@(_GeneratedNuspec)' != ''">
      <Output TaskParameter="Result" ItemName="_InexactSemanticRouterDependency" />
    </XmlPeek>
    <Delete Files="@(_GeneratedPackage)" Condition="'@(_InexactSemanticRouterDependency)' != ''" />
    <Error Condition="'@(_InexactSemanticRouterDependency)' != ''"
           Text="$(PackageId) depends on @(_InexactSemanticRouterDependency, ', ') without an exact version. The first-party packages depend on each other exactly, as [x.y.z] (CONTRIBUTING.md#package-versions-and-dependencies)." />
  </Target>
</Project>
