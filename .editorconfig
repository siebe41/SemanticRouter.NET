root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true

# Library code should not capture a sync context.
dotnet_diagnostic.CA2007.severity = warning

[tests/**.cs]
dotnet_diagnostic.CA2012.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

[samples/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none

[src/SemanticRouter.{Host,Hosting,Desktop}/**.cs]
# Application code, not a library: there is no synchronization context to avoid (the desktop app's UI thread
# continuations are wanted).
dotnet_diagnostic.CA2007.severity = none

[benchmarks/**.cs]
dotnet_diagnostic.CA2007.severity = none
