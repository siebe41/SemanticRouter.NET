#!/usr/bin/env node
// Stands in for the `claude` CLI in the demo video. The router's calls (print mode without session persistence) are
// answered in Claude Code's stream-json format with the reply from ../replies.js, a little slower than the local
// models. While the file named by DEMO_CLAUDE_LIMIT_FILE exists they get Claude Code's session-limit message instead,
// so the router's quota cooldown and failover are the real ones. Anything else (you at the terminal) is handed to the
// real Claude Code named by DEMO_REAL_CLAUDE.
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const args = process.argv.slice(2);
const fromRouter = args.includes('-p') && args.includes('--no-session-persistence');
if (!fromRouter && process.env.DEMO_REAL_CLAUDE) {
  process.exit(spawnSync(process.env.DEMO_REAL_CLAUDE, args, { stdio: 'inherit' }).status ?? 1);
}

const { replyFor, words } = require(path.join(fs.realpathSync(__dirname), '..', 'replies.js'));
const { cachedPrefixOnDisk } = require(path.join(fs.realpathSync(__dirname), '..', 'prompt-cache.js'));
const model = args.includes('--model') ? args[args.indexOf('--model') + 1] : 'sonnet';
const limitFile = process.env.DEMO_CLAUDE_LIMIT_FILE;
const write = (o) => process.stdout.write(JSON.stringify(o) + '\n');
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// The router renders the conversation as a transcript of "[user]" / "[assistant]" turns; the last user turn is what
// this answers.
function latestPrompt(transcript) {
  const at = transcript.lastIndexOf('[user]\n');
  return at >= 0 ? transcript.slice(at + '[user]\n'.length) : transcript;
}

let input = '';
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', async () => {
  const prompt = latestPrompt(input);
  await sleep(700 + Math.random() * 400);
  if (limitFile && fs.existsSync(limitFile)) {
    write({ type: 'result', subtype: 'success', is_error: true, result: "You've hit your session limit · resets 5pm" });
    process.exit(1);
  }

  const reply = replyFor(prompt);
  write({ type: 'system', subtype: 'init', model });
  for (const word of words(reply)) {
    write({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text: word } } });
    if (!process.env.DEMO_FULL_ANSWERS) await sleep(28); // long answers off camera need no typing pace
  }
  // Everything Claude would read counts: the conversation on stdin and the system prompt passed as an argument. In the
  // savings video the part a recent request already sent is a cache read and the rest a cache write, as Claude Code's
  // requests are billed.
  const read = process.argv.slice(2).join(' ') + input;
  const usage = { input_tokens: Math.round(read.length / 4), output_tokens: words(reply).length };
  if (process.env.DEMO_FULL_ANSWERS) {
    const cached = cachedPrefixOnDisk(read);
    Object.assign(usage, { input_tokens: 0, cache_read_input_tokens: Math.floor(cached / 4), cache_creation_input_tokens: Math.round((read.length - cached) / 4) });
  }
  write({ type: 'result', subtype: 'success', is_error: false, result: reply, usage });
});
