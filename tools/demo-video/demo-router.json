{
  // The configuration the demo video records. serve.js fills in the placeholders: LM Studio is a stub HTTP server
  // (__LMSTUDIO__) and Claude Code is fake-claude/claude (__CLAUDE__) behind the real CLI connector, which record.js
  // can switch to "you've hit your session limit" mid-video.
  "DefaultSimilarityThreshold": 0.3,
  "FallbackTier": 1,
  "Selection": { "Strategy": "CheapestCapable", "AllowBelowRequiredTier": true, "QuotaCooldown": "00:15:00" },
  "Tiers": [
    { "Level": 1, "Name": "Local small", "Description": "Small talk, rewrites, private lookups." },
    { "Level": 2, "Name": "Local coder", "Description": "Everyday code." },
    { "Level": 4, "Name": "Claude", "Description": "Design, debugging, agentic work." },
    { "Level": 5, "Name": "Claude Opus", "Description": "The hardest prompts." }
  ],
  "Routes": [
    { "Name": "smalltalk", "Tier": 1, "Utterances": [ "hello, how are you today?", "thanks a lot", "tell me a joke", "good morning" ] },
    { "Name": "rewrite-summarize", "Tier": 1, "Utterances": [ "summarize this text", "rewrite this to sound more professional", "fix the grammar in this sentence", "translate this to French" ] },
    { "Name": "everyday-code", "Tier": 2, "RequiredCapabilities": [ "code" ], "Utterances": [ "write a unit test for this function", "write a regex that matches email addresses", "convert this loop to LINQ", "add null checks to this method" ] },
    { "Name": "deep-reasoning", "Tier": 4, "Utterances": [ "compare the trade-offs between event sourcing and CRUD", "design a scalable architecture for a multi-tenant platform", "find the root cause of this memory leak", "why does this async code deadlock" ] },
    { "Name": "agentic-coding", "Tier": 5, "RequiredCapabilities": [ "code" ], "Utterances": [ "implement this feature across the codebase", "refactor the module and update every caller", "fix the failing tests and make the build pass" ] },
    { "Name": "private", "Tier": 1, "LocalOnly": true, "SimilarityThreshold": 0.3, "Utterances": [ "look up the customer record for account number", "show the employee salary history", "what is the patient's medical history" ] }
  ],
  "Models": [
    { "Name": "lmstudio-small", "Connector": "lmstudio", "Model": "qwen/qwen3-8b", "Tier": 1, "IsLocal": true, "Capabilities": [ "chat" ] },
    { "Name": "lmstudio-coder", "Connector": "lmstudio", "Model": "qwen/qwen3-coder-30b", "Tier": 2, "IsLocal": true, "Capabilities": [ "chat", "code", "tools" ] },
    { "Name": "claude-code", "Connector": "claude-cli", "Model": "sonnet", "Tier": 4, "Capabilities": [ "chat", "code", "reasoning", "tools" ], "ContextWindow": 200000 },
    { "Name": "claude-code-opus", "Connector": "claude-cli", "Model": "opus", "Tier": 5, "Capabilities": [ "chat", "code", "reasoning", "tools" ], "ContextWindow": 200000 }
  ],
  "Connectors": {
    "lmstudio": { "Type": "OpenAICompatible", "BaseAddress": "__LMSTUDIO__" },
    "claude-cli": { "Type": "Cli", "Preset": "ClaudeCode", "Executable": "__CLAUDE__", "MaxConcurrency": 4, "ToolCalling": "Prompted" }
  },
  "Memory": { "Sources": [ { "Name": "obsidian", "Type": "Markdown", "Path": "__VAULT__" } ] },
  "Embeddings": { "Provider": "Hashing", "WarmUpOnStartup": true },
  "Middleware": {
    "Mode": "Dispatch",
    "PathPrefixes": [ "/v1/chat/completions", "/v1/messages", "/v1/responses" ],
    "GatewayKeys": { "claude-code-laptop": "demo-key-claude-code", "open-webui": "demo-key-open-webui", "codex-cli": "demo-key-codex" },
    "ModelAliases": { "*haiku*": "auto:cheapest", "*sonnet*": "auto", "*opus*": "auto:best", "claude-*": "auto" }
  }
}
