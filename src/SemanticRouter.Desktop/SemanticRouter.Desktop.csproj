<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop app: a tray (menu bar) icon that hosts the router in-process, or uses the background service when one
    already runs, and shows the dashboard in a window on the platform's own web view or in the browser.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A GUI program: Windows gives it no console window. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>SemanticRouter.Desktop</RootNamespace>
    <AssemblyName>SemanticRouter</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Published per runtime by deploy/publish-desktop.sh; the lock file covers each (Directory.Build.props). -->
    <RuntimeIdentifiers>$(DesktopRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticRouter.Hosting\SemanticRouter.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
    <!-- The tray icons, drawn from deploy/icon.svg by deploy/make-tray-icons.py. -->
    <AvaloniaResource Include="Assets\tray-template@2x.png;Assets\tray.ico;Assets\tray.png" />
    <!-- Sigstore's public-good trust root, which an update's attestation is checked against (UpdateAttestation). -->
    <EmbeddedResource Include="Assets\sigstore-trusted-root.json" LogicalName="sigstore-trusted-root.json" />
    <!-- The icon a Linux autostart entry points at. -->
    <None Include="Assets\icon.png" Link="semantic-router.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticRouter.Tests" />
  </ItemGroup>

  <!-- ONNX Runtime ships Android and iOS archives (110 MB) that a desktop app never loads. -->
  <Target Name="DropMobileOnnxRuntimeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'android' Or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'ios'" />
    </ItemGroup>
  </Target>

  <!--
    Files the app never uses, left out where they are resolved so the deps.json manifest does not list them either: the
    native debug symbols and import libraries that SkiaSharp, HarfBuzzSharp and ONNX Runtime carry (105 MB on Windows;
    -p:DebugType=none drops only the managed ones) and ASP.NET Core's IIS in-process module (the app is never hosted by
    IIS). Velopack's packer already leaves the symbols out of the installers; this keeps them out of the zip and tar.gz
    archives too.
  -->
  <Target Name="DropUnusedNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.lib'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

  <Target Name="DropIisModule" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)' == 'aspnetcorev2_inprocess'" />
    </ItemGroup>
  </Target>

  <!-- The libraries' XML documentation, which only an IDE reads, and the IIS module's file, published by another route. -->
  <Target Name="DropUnusedFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'aspnetcorev2_inprocess' Or ('%(Extension)' == '.xml' And $([System.String]::Copy('%(Filename)').StartsWith('SemanticRouter.')))" />
    </ItemGroup>
  </Target>

</Project>
