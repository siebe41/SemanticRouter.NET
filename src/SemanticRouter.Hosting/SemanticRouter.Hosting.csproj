<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The router as an application, shared by the `semantic-router` tool and the desktop app: building and running the
    host, the configuration directory, init, doctor, models, the background service and the running-instance record.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SemanticRouter.Host</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticRouter.AspNetCore\SemanticRouter.AspNetCore.csproj" />
    <ProjectReference Include="..\SemanticRouter.Storage.Sqlite\SemanticRouter.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\SemanticRouter.Embeddings.Onnx\SemanticRouter.Embeddings.Onnx.csproj" />
    <ProjectReference Include="..\SemanticRouter.Connectors.Copilot\SemanticRouter.Connectors.Copilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The neutral starting configuration: tiers, generic routes, no models until `init` or the dashboard adds them. -->
    <EmbeddedResource Include="Templates\semantic-router.template.json" LogicalName="semantic-router.template.json" />
    <EmbeddedResource Include="Templates\semantic-router.evaluation.jsonl" LogicalName="semantic-router.evaluation.jsonl" />
    <Content Remove="Templates\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="semantic-router" />
    <InternalsVisibleTo Include="SemanticRouter" />
    <InternalsVisibleTo Include="SemanticRouter.Tests" />
  </ItemGroup>

</Project>
