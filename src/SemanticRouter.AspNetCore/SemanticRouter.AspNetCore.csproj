<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SemanticRouter.AspNetCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ASP.NET Core integration for SemanticRouter: DI registration, prompt routing middleware and HTTP dispatch to local or cloud LLM endpoints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticRouter.Core\SemanticRouter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dashboard single-page app, served by MapRouterDashboard(). -->
    <EmbeddedResource Include="Dashboard\wwwroot\*" LogicalName="dashboard/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticRouter.Tests" />
  </ItemGroup>

</Project>
