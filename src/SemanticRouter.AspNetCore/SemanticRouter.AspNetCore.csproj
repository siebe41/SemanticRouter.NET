<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SemanticRouter.AspNetCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ASP.NET Core integration for SemanticRouter: DI registration, prompt routing middleware and HTTP dispatch to local or cloud LLM endpoints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticRouter.Core\SemanticRouter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dashboard single-page app, served by MapRouterDashboard(). -->
    <EmbeddedResource Include="Dashboard\wwwroot\*" LogicalName="dashboard/%(Filename)%(Extension)" />
    <!-- Native ES modules, served from /js/; no build step. -->
    <EmbeddedResource Include="Dashboard\wwwroot\js\*.js" LogicalName="dashboard/js/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Connectors\model-families.json" LogicalName="SemanticRouter.AspNetCore.model-families.json" />
    <EmbeddedResource Include="Middleware\client-turns.json" LogicalName="SemanticRouter.AspNetCore.client-turns.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticRouter.Tests" />
    <!-- First-party connector package, versioned with this one: it reuses the response writers and transcript renderer. -->
    <InternalsVisibleTo Include="SemanticRouter.Connectors.Copilot" />
    <!-- First-party storage and host, versioned with this one: they keep the same file modes. -->
    <InternalsVisibleTo Include="SemanticRouter.Storage.Sqlite" />
    <InternalsVisibleTo Include="SemanticRouter.Hosting" />
  </ItemGroup>

</Project>
