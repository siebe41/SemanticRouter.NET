<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SemanticRouter.AspNetCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ASP.NET Core integration for SemanticRouter: DI registration, prompt routing middleware and HTTP dispatch to local or cloud LLM endpoints.</Description>
    <!-- The desktop app references it: restored for the app's runtimes too, built once (Directory.Build.props). -->
    <RuntimeIdentifiers>$(DesktopRuntimeIdentifiers)</RuntimeIdentifiers>
    <IsRidAgnostic>true</IsRidAgnostic>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticRouter.Core\SemanticRouter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dashboard single-page app, served by MapRouterDashboard(). -->
    <EmbeddedResource Include="Dashboard\wwwroot\*" LogicalName="dashboard/%(Filename)%(Extension)" />
    <!-- Native ES modules, served from /js/; no build step. -->
    <EmbeddedResource Include="Dashboard\wwwroot\js\*.js" LogicalName="dashboard/js/%(Filename)%(Extension)" />
    <!-- Inter and Fira Sans (SIL OFL 1.1, licences beside them), so the dashboard asks no other host for fonts. -->
    <EmbeddedResource Include="Dashboard\wwwroot\fonts\*" LogicalName="dashboard/fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Connectors\model-families.json" LogicalName="SemanticRouter.AspNetCore.model-families.json" />
    <EmbeddedResource Include="Middleware\client-turns.json" LogicalName="SemanticRouter.AspNetCore.client-turns.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticRouter.Tests" />
    <!--
      The packages below are versioned with this one and depend on it exactly ([x.y.z]), so the internals they use are a
      contract between the packages of one version (CONTRIBUTING.md, Package versions and dependencies, lists them).
    -->
    <!-- First-party connector package: it reuses the response writers and transcript renderer. -->
    <InternalsVisibleTo Include="SemanticRouter.Connectors.Copilot" />
    <!-- First-party storage and host (the host is not packed): they keep the same file modes. -->
    <InternalsVisibleTo Include="SemanticRouter.Storage.Sqlite" />
    <InternalsVisibleTo Include="SemanticRouter.Hosting" />
  </ItemGroup>

</Project>
