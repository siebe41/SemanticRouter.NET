    { "family": "Gemma 3", "match": ["gemma-3", "gemma3"], "without": ["tools"], "notes": "No native tool calling." },
    { "family": "Phi-4 reasoning", "match": ["phi-4-reasoning", "phi4-reasoning"], "capabilities": ["reasoning"] },
    { "family": "Phi-4", "match": ["phi-4", "phi4"], "notes": "Strong at reasoning and maths for its size." },
    { "family": "Granite", "match": ["granite"], "capabilities": ["tools"] },
    { "family": "GLM-4.5", "match": ["glm-4.5", "glm-4.6", "glm4.5", "glm4.6"], "capabilities": ["code", "tools", "reasoning"] },
    { "family": "Gemini Flash", "match": ["gemini-*flash"], "tier": 2, "capabilities": ["code", "tools", "vision"] },
    { "family": "Gemini Pro", "match": ["gemini-*pro"], "tier": 3, "capabilities": ["code", "tools", "vision", "reasoning"] }
  ]
