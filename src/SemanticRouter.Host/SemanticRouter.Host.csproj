<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SemanticRouter.Host</RootNamespace>
    <AssemblyName>semantic-router</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>semantic-router</ToolCommandName>
    <PackageId>SemanticRouter.Host</PackageId>
    <Description>A ready-to-run semantic prompt router: point Claude Code, Codex or any OpenAI/Anthropic client at it and it picks local models, subscription CLIs or paid APIs per turn. Includes the dashboard. Install with `dotnet tool install -g SemanticRouter.Host`.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;claude-code;gateway</PackageTags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Logs and the start-up banner use the invariant culture; no satellite resources are needed. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything but the command-line entry point lives in SemanticRouter.Hosting, shared with the desktop app. -->
    <ProjectReference Include="..\SemanticRouter.Hosting\SemanticRouter.Hosting.csproj" />
  </ItemGroup>

  <!--
    The notices for the packages the tool ships, at the package root. The release (and CI) generates the file with
    deploy/third-party-notices.cs from this project's deps.json and passes it as -p:ThirdPartyNoticesFile=<path>.
  -->
  <ItemGroup Condition="'$(ThirdPartyNoticesFile)' != ''">
    <None Include="$(ThirdPartyNoticesFile)" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" Visible="false" />
  </ItemGroup>

  <!-- ONNX Runtime ships Android and iOS archives (110 MB) that a desktop or server tool never loads. -->
  <Target Name="DropMobileOnnxRuntimeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'android' Or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'ios'" />
    </ItemGroup>
  </Target>

</Project>
