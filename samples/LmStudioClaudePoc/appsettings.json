{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "SemanticRouter": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Personal subscription CLIs must only serve this machine: keep the router on localhost.
  "Urls": "http://localhost:5090",

  "SemanticRouter": {
    // Two-tier proof of concept: tier 1 = LM Studio, tier 3 = Claude Code.
    // Unmatched prompts start at tier 1 (local); complexity can push them to Claude.
    "DefaultSimilarityThreshold": 0.30,
    "FallbackTier": 1,
    "ComplexityTiers": [ { "MinScore": 0.6, "Tier": 3 } ],

    "Selection": {
      "Strategy": "CheapestCapable",
      // If Claude is unavailable (not installed, signed out, session limit), hard prompts fall back to LM Studio.
      "AllowBelowRequiredTier": true,
      "QuotaCooldown": "00:15:00",
      "FailureCooldown": "00:00:30"
    },

    "Routes": [
      {
        "Name": "local-easy",
        "Tier": 1,
        "Utterances": [
          "hi there", "hello, how are you?", "thanks a lot", "tell me a joke",
          "summarize this text", "summarize this in one sentence", "rewrite this to sound more professional",
          "fix the grammar in this sentence", "translate this to French", "make this shorter",
          "what is the capital of France", "define the word ephemeral"
        ]
      },
      {
        "Name": "claude-hard",
        "Tier": 3,
        "Utterances": [
          "design a scalable architecture for a multi-tenant platform",
          "compare the trade-offs between event sourcing and CRUD",
          "debug this race condition in my multithreaded code", "why does this async code deadlock",
          "explain step by step how to migrate a monolith to microservices",
          "review this code for security vulnerabilities", "find the root cause of this memory leak",
          "prove this algorithm is correct", "analyze the risks in this contract"
        ]
      },
      {
        "Name": "private",
        "Description": "Never leaves this machine, even if LM Studio is down.",
        "Tier": 1,
        "LocalOnly": true,
        "SimilarityThreshold": 0.35,
        "Utterances": [
          "look up the customer record for account number", "show the employee salary history",
          "what is the patient's medical history", "find the social security number for this customer"
        ]
      }
    ],

    "Models": [
      {
        "Name": "lmstudio",
        "Connector": "lmstudio",
        // Leave empty to use the first chat model LM Studio reports, or set the exact id from
        // `curl http://localhost:1234/v1/models` (or pass --SemanticRouter:Models:0:Model=<id>).
        "Model": "",
        "Tier": 1,
        "IsLocal": true,
        "Capabilities": [ "chat", "tools" ]
      },
      {
        "Name": "claude",
        "Connector": "claude-cli",
        // sonnet | opus | haiku, or a full model name.
        "Model": "sonnet",
        "Tier": 3,
        "ContextWindow": 200000,
        "Capabilities": [ "chat", "code", "reasoning" ]
      }
    ],

    "Connectors": {
      "lmstudio": { "Type": "OpenAICompatible", "BaseAddress": "http://localhost:1234", "Timeout": "00:02:00" },
      // Runs your installed `claude` binary with your own login. Set "Executable" to a full path if it is not on PATH
      // (on Windows, point it at claude.exe).
      "claude-cli": { "Type": "Cli", "Preset": "ClaudeCode", "MaxConcurrency": 2, "Timeout": "00:03:00" }
    },

    // Lexical embeddings: no embedding model needed for the proof of concept.
    "Embeddings": { "Provider": "Hashing", "Dimensions": 512 },

    "Middleware": {
      "Mode": "Dispatch",
      "PathPrefixes": [ "/v1/chat/completions" ]
    }
  }
}
