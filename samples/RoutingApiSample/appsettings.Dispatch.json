{
  // Activated with ASPNETCORE_ENVIRONMENT=Dispatch (see the "dispatch" launch profile).
  // Serves /v1/chat/completions for real: LM Studio for easy prompts, the Claude Code CLI (your own
  // subscription) for hard ones, and automatic failover between them. Requires:
  //   * LM Studio's server running on :1234 with a chat model and an embedding model loaded
  //   * the `claude` CLI installed and signed in (run `claude` once and /login)
  "SemanticRouter": {
    // nomic-embed-text produces much higher similarities than the hashing provider.
    "DefaultSimilarityThreshold": 0.62,
    "Embeddings": {
      "Provider": "OpenAICompatible",
      "Endpoint": "http://localhost:1234",
      "Model": "text-embedding-nomic-embed-text-v1.5",
      "Timeout": "00:00:05"
    },
    "Middleware": {
      "Mode": "Dispatch",
      "PathPrefixes": [ "/v1/chat/completions" ]
    }
  }
}
