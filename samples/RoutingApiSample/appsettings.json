{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SemanticRouter": "Information"
    }
  },
  "AllowedHosts": "*",
  "SemanticRouter": {
    // Tuned for the in-process Hashing provider. Real embedding models need higher values (see README).
    "DefaultSimilarityThreshold": 0.30,
    "FallbackTier": 3,
    "ComplexityShortCircuitThreshold": 0.9,
    "AmbiguityMargin": 0.02,
    // Complexity can only raise a route's tier: 0.45 → tier 2, 0.65 → tier 3, 0.85 → tier 4.
    "ComplexityTiers": [
      { "MinScore": 0.45, "Tier": 2 },
      { "MinScore": 0.65, "Tier": 3 },
      { "MinScore": 0.85, "Tier": 4 }
    ],

    "Selection": {
      // CheapestCapable: the cheapest model whose tier is high enough; ties go to the lowest sufficient tier,
      // so premium subscription quota is kept for prompts that need it. Clients can override per request with
      // "model": "auto:cheapest" | "auto:best" | "auto:priority", or name a catalog model directly.
      "Strategy": "CheapestCapable",
      "AllowBelowRequiredTier": true,
      "MaxAttempts": 3,
      "QuotaCooldown": "00:15:00",
      "FailureCooldown": "00:00:30"
    },

    // Tier scale used below: 1 small local · 2 mid local/mini · 3 strong · 4 frontier · 5 frontier + deep reasoning.
    "Routes": [
      {
        "Name": "smalltalk",
        "Description": "Greetings, thanks and chit-chat.",
        "Tier": 1,
        "Utterances": [
          "hi there", "hello, how are you?", "good morning", "thanks a lot",
          "thank you for your help", "who are you?", "tell me a joke", "what can you do?"
        ]
      },
      {
        "Name": "rewrite-summarize",
        "Description": "Light text transformation that small models handle well.",
        "Tier": 1,
        "Utterances": [
          "summarize this text", "summarize this article in three bullet points", "give me a short summary of this email",
          "rewrite this paragraph to sound more professional", "fix the grammar and spelling in this sentence",
          "translate this sentence to French", "make this message shorter", "rephrase this in simpler words"
        ]
      },
      {
        "Name": "simple-code",
        "Description": "Small, self-contained coding tasks a local coder model can do.",
        "Tier": 2,
        "RequiredCapabilities": [ "code" ],
        "Utterances": [
          "write a regex that matches email addresses", "write a unit test for this function", "add a docstring to this method",
          "convert this json to yaml", "write a commit message for this diff", "rename this variable everywhere",
          "write a bash one-liner to count lines in all files"
        ]
      },
      {
        "Name": "internal-records",
        "Description": "Sensitive internal data: only local models may answer, even on failover.",
        "Tier": 1,
        "LocalOnly": true,
        "SimilarityThreshold": 0.35,
        "Utterances": [
          "look up the customer record for account number", "show the employee salary history",
          "what is the patient's medical history", "find the social security number for this customer",
          "list the invoices for customer id"
        ]
      },
      {
        "Name": "deep-reasoning",
        "Description": "Analysis, design and multi-step reasoning.",
        "Tier": 4,
        "Utterances": [
          "design a scalable architecture for a multi-tenant SaaS platform",
          "compare the trade-offs between event sourcing and CRUD", "analyze this contract for legal risks",
          "prove that the square root of two is irrational", "write a business strategy for entering the European market",
          "explain step by step how to migrate a monolith to microservices",
          "evaluate the security implications of this authentication flow"
        ]
      },
      {
        "Name": "complex-code",
        "Description": "Debugging and non-trivial engineering work.",
        "Tier": 4,
        "RequiredCapabilities": [ "code" ],
        "Utterances": [
          "debug this race condition in my multithreaded code", "find the memory leak in this service",
          "refactor this legacy class to use dependency injection", "why does this async code deadlock",
          "optimize this SQL query that is timing out", "review this pull request for bugs"
        ]
      }
    ],

    // The model catalog. Costs are marginal USD per million tokens: 0 for local models and for flat-rate
    // subscriptions (until their quota runs out, at which point the router cools them down and moves on).
    // Prices and model IDs for paid APIs are examples: check your provider's current pricing and model list.
    "Models": [
      {
        "Name": "lmstudio-small", "Connector": "lmstudio", "Model": "qwen/qwen3-8b",
        "Tier": 1, "IsLocal": true, "ContextWindow": 32768, "Capabilities": [ "chat" ]
      },
      {
        "Name": "lmstudio-coder", "Connector": "lmstudio", "Model": "qwen/qwen3-coder-30b",
        "Tier": 2, "IsLocal": true, "ContextWindow": 65536, "Capabilities": [ "chat", "code", "tools" ]
      },
      {
        "Name": "claude-code", "Connector": "claude-cli", "Model": "sonnet",
        "Tier": 4, "ContextWindow": 200000, "Capabilities": [ "chat", "code", "reasoning" ],
        "Description": "Claude Code CLI on your own Claude subscription (personal, local use)."
      },
      {
        "Name": "claude-code-opus", "Connector": "claude-cli", "Model": "opus",
        "Tier": 5, "ContextWindow": 200000, "Capabilities": [ "chat", "code", "reasoning" ], "Priority": 1
      },
      {
        "Name": "copilot", "Connector": "copilot-cli", "Model": "claude-sonnet-5.5", "Enabled": false,
        "Tier": 4, "Capabilities": [ "chat", "code" ], "Priority": 2,
        "Description": "GitHub Copilot CLI on your Copilot plan (uses AI credits from your allowance)."
      },
      {
        "Name": "codex", "Connector": "codex-cli", "Model": "gpt-6.1-sol", "Enabled": false,
        "Tier": 4, "Capabilities": [ "chat", "code", "reasoning" ], "Priority": 2,
        "Description": "OpenAI Codex CLI on your ChatGPT plan."
      },
      {
        "Name": "openai-mini", "Connector": "openai", "Model": "gpt-6-luna", "Enabled": false,
        "Tier": 2, "ContextWindow": 128000, "Capabilities": [ "chat", "code", "tools", "vision" ],
        "InputCostPerMillionTokens": 0.4, "OutputCostPerMillionTokens": 1.6
      },
      {
        "Name": "gemini-flash", "Connector": "gemini", "Model": "gemini-3.8-flash", "Enabled": false,
        "Tier": 3, "ContextWindow": 1000000, "Capabilities": [ "chat", "code", "tools", "vision" ],
        "InputCostPerMillionTokens": 0.3, "OutputCostPerMillionTokens": 2.5
      },
      {
        "Name": "anthropic-opus", "Connector": "anthropic", "Model": "claude-opus-5-5", "Enabled": false,
        "Tier": 5, "ContextWindow": 200000, "Capabilities": [ "chat", "code", "tools", "vision", "reasoning" ],
        "InputCostPerMillionTokens": 15, "OutputCostPerMillionTokens": 75
      }
    ],

    // How to reach each provider. API keys belong in user-secrets or environment variables, e.g.
    //   dotnet user-secrets set "SemanticRouter:Connectors:openai:ApiKey" "<key>"
    "Connectors": {
      "lmstudio": { "Type": "OpenAICompatible", "BaseAddress": "http://localhost:1234", "Timeout": "00:02:00" },
      "claude-cli": { "Type": "Cli", "Preset": "ClaudeCode", "MaxConcurrency": 2, "Timeout": "00:03:00" },
      "copilot-cli": { "Type": "Cli", "Preset": "GitHubCopilot", "MaxConcurrency": 2 },
      "codex-cli": { "Type": "Cli", "Preset": "Codex", "MaxConcurrency": 1 },
      "openai": { "Type": "OpenAICompatible", "BaseAddress": "https://api.openai.com" },
      "gemini": {
        "Type": "OpenAICompatible", "BaseAddress": "https://generativelanguage.googleapis.com",
        "RequestPath": "/v1beta/openai/chat/completions"
      },
      "anthropic": { "Type": "OpenAICompatible", "BaseAddress": "https://api.anthropic.com" }
    },

    "Embeddings": {
      "Provider": "Hashing",
      "Dimensions": 512,
      "WarmUpOnStartup": true
    },

    "Middleware": {
      "Mode": "Annotate",
      "PathPrefixes": [ "/v1/chat/completions", "/semantic-router/classify" ],
      "MaxRequestBodyBytes": 1048576,
      "EmitResponseHeaders": true,
      "HeaderPrefix": "X-Prompt-Route",
      "FailOpen": true,
      "MessageSelection": "LastUserMessage"
    }
  }
}
