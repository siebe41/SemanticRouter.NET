<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the vendor CLIs (claude, codex, copilot, custom tools) used by the process integration tests.
    One .NET program instead of shell scripts, so the same tests run on Windows, macOS and Linux.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>fake-cli</AssemblyName>
    <RootNamespace>SemanticRouter.FakeCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
