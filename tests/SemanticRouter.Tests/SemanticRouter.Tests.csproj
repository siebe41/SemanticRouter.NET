<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SemanticRouter.Core\SemanticRouter.Core.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.AspNetCore\SemanticRouter.AspNetCore.csproj" />
    <!-- The stand-in CLI for process integration tests; its executable is copied next to the tests. -->
    <ProjectReference Include="..\SemanticRouter.FakeCli\SemanticRouter.FakeCli.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Host\SemanticRouter.Host.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Hosting\SemanticRouter.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Desktop\SemanticRouter.Desktop.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Storage.Sqlite\SemanticRouter.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Embeddings.Onnx\SemanticRouter.Embeddings.Onnx.csproj" />
    <ProjectReference Include="..\..\src\SemanticRouter.Connectors.Copilot\SemanticRouter.Connectors.Copilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Configuration directories made by each release (tools/upgrade-fixtures), for UpgradeFromReleasedVersionsTests. -->
    <None Include="..\fixtures\upgrade\*.zip" Link="fixtures\upgrade\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- A list of files written by deploy/update-file-list.cs, for UpdateControlTests. -->
    <None Include="..\fixtures\update-file-list\*.dll" Link="fixtures\update-file-list\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The desktop app's tray icons, for DesktopTests. -->
    <None Include="..\..\src\SemanticRouter.Desktop\Assets\tray*" Link="tray-icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The intended public API of the library packages, for ApiSurfaceDocumentationTests. -->
    <None Include="..\..\docs\api-surface.md" Link="docs\api-surface.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
