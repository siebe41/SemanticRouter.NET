<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>SemanticRouter.NET contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/siebe41/SemanticRouter.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/siebe41/SemanticRouter.NET</RepositoryUrl>
    <PackageTags>llm;routing;semantic-router;embeddings;aspnetcore;ollama</PackageTags>
  </PropertyGroup>
</Project>
